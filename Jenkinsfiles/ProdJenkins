pipeline {
    agent { label 'Africa' }
    environment {
        FTP_SERVER = credentials('abreu_fpt_host')
        NUGET_SOURCE = credentials('private_nuget_uri')
        SONARQUBE_EXCLUDE_FILES = "**/*.xml,**/*.json,**/*.html,**/*.css,**/*.js,**/Program.cs,**/Startup.cs,**/Migrations/**"
    }

    stages {
        stage('Restore dependencies') {
            steps {
                echo 'Restoring specific project dependencies from NuGet...'
                sh '''
                    dotnet restore KuhakuCentral.sln \
                        --source $NUGET_SOURCE \
                        --source https://api.nuget.org/v3/index.json
                '''
            }
        }

        stage('Compile project') {
            steps {
                echo 'Compiling the project...'
                sh 'dotnet build KuhakuCentral.sln --configuration Release'
            }
        }

        stage('Deploy to FTP') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'abreu_kuhaku_ftp_credentials', 
                                                 usernameVariable: 'FTP_USER', 
                                                 passwordVariable: 'FTP_PASSWORD')]) {
                    script {
                        def buildDirectory = 'Presentation.KuhakuCentral/bin/Release/net8.0/'
                        if (fileExists(buildDirectory)) {
                            echo "Directory exists. Deploying files to FTP..."
                            sh """
                                lftp -u "$FTP_USER","$FTP_PASSWORD" $FTP_SERVER -e "
                                    set ssl:verify-certificate no;
                                    mirror -R ${buildDirectory} .;
                                    bye;
                                "
                            """
                        } else {
                            echo "Build directory not found. No files to upload."
                            error "Deployment failed: Directory $buildDirectory not found."
                        }
                    }
                }
            }
        }

    }

}
